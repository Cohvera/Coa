# Copy to .env and replace these passwords before starting.
QHOME_ADMIN_PASSWORD=replace-with-a-strong-admin-password
QHOME_USER_PASSWORD=replace-with-a-different-calculator-password
# Set to 1 behind HTTPS. Local HTTP needs 0.
QHOME_SECURE_COOKIE=0
# Optional module URL when using a reverse proxy / separate hostname.
VITE_QHOME_URL=
